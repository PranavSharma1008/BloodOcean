PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/blood-donation-finder?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_random_32_plus_character_secret
JWT_EXPIRE=7d
NODE_ENV=development
FRONTEND_URL=https://bloodocean.vercel.app

# ─── Email Config (required for password reset) ───────────────────────────────
# Choose ONE of the two options below:

# Option A: SendGrid (RECOMMENDED for production — no 2FA issues)
#  1. Sign up at https://sendgrid.com (free: 100 emails/day)
#  2. Create a sender identity (Settings > Sender Authentication)
#  3. Create an API key (Settings > API Keys) — starts with "SG."
#  4. EMAIL_SERVICE will be auto-set to SendGrid when you use these host-based settings
#
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASS=SG.your_sendgrid_api_key_here
# EMAIL_FROM=your-verified-sender@yourdomain.com

# Option B: Gmail (development only)
#  1. Enable 2FA at https://myaccount.google.com/security
#  2. Generate App Password at https://myaccount.google.com/apppasswords
#  3. Use the 16-character code (no spaces) as EMAIL_PASS
#  4. Your regular Gmail password will NOT work with 2FA enabled
#
# EMAIL_SERVICE=Gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=xxxx xxxx xxxx xxxx    # App Password, remove spaces when pasting
# EMAIL_FROM=your-email@gmail.com
